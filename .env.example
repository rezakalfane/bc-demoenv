# Optional development mirror. When set, the dev server uses this local SQLite
# file and exposes explicit Pull/Push actions on Settings -> Profile.
LOCAL_DATABASE_URL=file:local.db

# Remote Turso database. Vercel deployments receive these from the Marketplace
# integration; local development needs them only when using the mirror actions.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Required outside development for whole-database backup/restore. This is an
# explicit comma-separated allow-list because backups contain every tenant's data.
DATABASE_BACKUP_ALLOWED_EMAILS=

# Authenticates Vercel Cron requests to the one-minute scheduler dispatcher.
# Use the same server-only value in every Vercel environment that runs Cron.
CRON_SECRET=

# Provision through the Clerk Vercel Marketplace integration.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Encrypts saved BigCommerce access tokens. Generate with: openssl rand -base64 32
# If omitted, the app derives a key from CLERK_SECRET_KEY for local compatibility.
SETTINGS_ENCRYPTION_KEY=

# Optional: enables live snapshot publish/unpublish updates across signed-in users.
# Create an Ably app and keep this server API key private.
ABLY_API_KEY=
